<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E9E4E6">

    <!-- CLOSE BUTTON -->
    <TextView
        android:id="@+id/btnClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="22dp"
        android:text="×"
        android:textColor="#7A2F42"
        android:textSize="24sp" />

    <!-- TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="90dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone"
            android:textColor="#7A2F42"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification"
            android:textColor="#1A1A1A"
            android:textSize="28sp" />
    </LinearLayout>

    <!-- BOTTOM PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_verification_panel"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <!-- PHONE INPUT WITH +63 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_verification_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+63"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="9XXXXXXXXX"
                android:inputType="phone"
                android:maxLength="13"
                android:paddingStart="12dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#F4DFE5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- OTP -->
        <EditText
            android:id="@+id/etOtp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_verification_input"
            android:hint="OTP"
            android:inputType="number"
            android:paddingStart="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#F4DFE5"
            android:textSize="14sp" />

        <!-- RESEND -->
        <Button
            android:id="@+id/txtResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Resend OTP"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
             />

        <!-- CONFIRM BUTTON -->
        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_verification_button"
            android:backgroundTint="@null"
            android:text="Confirm"
            android:textAllCaps="false"
            android:textColor="#7A2F42"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- BACK -->
        <TextView
            android:id="@+id/txtBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="Back to Register"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
             />

    </LinearLayout>

</RelativeLayout>