<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/introRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <!-- introIconStage holds the real logo icon (logo_visualed_icon.png,
             cropped straight from logo_visualed.png) plus two overlay
             panels that hide the book until the intro's open-book beat.
             The panels are sized/positioned in code from the icon's actual
             pixel bounds, so they line up regardless of screen density. -->
        <FrameLayout
            android:id="@+id/introIconStage"
            android:layout_width="280dp"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/introIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_visualed_icon" />

            <View
                android:id="@+id/bookCoverLeft"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:background="@drawable/bg_intro_book_cover" />

            <View
                android:id="@+id/bookCoverRight"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:background="@drawable/bg_intro_book_cover" />

        </FrameLayout>

        <ImageView
            android:id="@+id/introWordmark"
            android:layout_width="210dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:alpha="0"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_visualed_wordmark" />

    </LinearLayout>

    <TextView
        android:id="@+id/introSkipHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0.55"
        android:text="@string/intro_tap_skip"
        android:textColor="@color/color_text_secondary"
        android:textSize="13sp" />

</FrameLayout>
